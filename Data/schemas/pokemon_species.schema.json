{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokemon-project.local/schemas/pokemon_species.schema.json",
  "title": "Pokemon Species Definition",
  "type": "object",
  "required": ["schemaVersion", "id", "displayName", "types", "habitatPreferences", "presentation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "types": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "habitatPreferences": { "type": "object", "required": ["preferredBiomeIds", "humidity", "vegetationDensity"], "properties": { "preferredBiomeIds": { "type": "array", "items": { "type": "string" } }, "humidity": { "$ref": "#/$defs/range" }, "vegetationDensity": { "$ref": "#/$defs/range" } }, "additionalProperties": false },
    "presentation": { "type": "object", "required": ["assetId"], "properties": { "assetId": { "type": "string" } }, "additionalProperties": false },
    "notes": { "type": "string" }
  },
  "$defs": { "range": { "type": "object", "required": ["min", "max"], "properties": { "min": { "type": "number" }, "max": { "type": "number" } }, "additionalProperties": false } },
  "additionalProperties": false
}
